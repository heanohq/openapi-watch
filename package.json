{
  "name": "openapi-watch",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that watches a third-party OpenAPI spec and opens an issue when it changes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs --legal-comments=none",
    "test": "node --test test/*.test.js",
    "diff-local": "node bin/openapi-watch.js"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
